{
  "id": "cyren-dotmm-populator",
  "title": "Sier's DotMM Populator for Cyren's Maps",
  "description": "Safely prepares static encounters for the Yawning Portal, Skullport, and Levels 1–23 on CyrensMaps for Undermountain using Actors already available in the World.",
  "version": "0.5.0",
  "authors": [
    {
      "name": "Sierrific",
      "url": "https://github.com/sierrific"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/populator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "12.331",
    "maximum": "14"
  },
  "url": "https://github.com/sierrific/sier-s-dotmm-populator-for-cyren-s-maps",
  "manifest": "https://raw.githubusercontent.com/sierrific/sier-s-dotmm-populator-for-cyren-s-maps/main/cyren-dotmm-populator/module.json",
  "download": "https://github.com/sierrific/sier-s-dotmm-populator-for-cyren-s-maps/releases/download/v0.5.0/cyren-dotmm-populator-0.5.0.zip",
  "relationships": {
    "requires": [
      {
        "id": "cyrensmaps-wdmm",
        "type": "module",
        "compatibility": {
          "minimum": "1.0.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "plutonium",
        "type": "module",
        "compatibility": {
          "minimum": "2.1.3"
        }
      }
    ],
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "3.1.2"
        }
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "js", "json"],
      "paths": ["scripts", "styles", "templates", "data", "lang"]
    }
  }
}
